{
	"name": "pi-desktop-notifications",
	"version": "0.1.0",
	"description": "Pi coding agent extension: native desktop notifications on macOS and Linux when the agent needs input or finishes a run",
	"type": "module",
	"main": "index.ts",
	"pi": {
		"extensions": ["./index.ts"]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test test/*.test.ts"
	},
	"keywords": [
		"pi",
		"pi-extension",
		"notifications",
		"desktop-notifications",
		"macos",
		"linux"
	],
	"license": "MIT",
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@types/node": "^22.0.0",
		"typescript": "^5.7.0"
	}
}
